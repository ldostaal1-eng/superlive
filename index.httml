<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SuperLive | Super Cup Database</title>
  <style>
    :root {
      --bg: #0b0e14;
      --card-bg: #151922;
      --card-border: #232936;
      --accent: #00e676;
      --accent-red: #ff3366;
      --accent-blue: #00b0ff;
      --accent-gold: #ffb300;
      --line-color: #3b4253;
      --text-main: #f1f5f9;
      --text-muted: #8e99ab;
      --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-family); }
    body { background-color: var(--bg); color: var(--text-main); line-height: 1.5; padding-bottom: 60px; }

    #splash-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: #080a0f;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      cursor: pointer;
      animation: autoFadeOut 0.5s ease 1.5s forwards;
    }

    @keyframes autoFadeOut {
      0% { opacity: 1; visibility: visible; }
      100% { opacity: 0; visibility: hidden; pointer-events: none; }
    }

    .splash-logo {
      font-size: 3.5rem;
      font-weight: 900;
      letter-spacing: 2px;
      color: #fff;
      opacity: 0;
      transform: scale(0.85);
      animation: splashPop 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .splash-logo span {
      color: var(--accent);
      text-shadow: 0 0 25px rgba(0, 230, 118, 0.4);
    }

    .splash-loader {
      width: 140px;
      height: 3px;
      background: #1c2230;
      border-radius: 4px;
      margin-top: 24px;
      overflow: hidden;
    }
    .splash-loader-bar {
      width: 0%;
      height: 100%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
      animation: loaderProgress 1.3s ease-in-out forwards;
    }

    @keyframes splashPop {
      0% { opacity: 0; transform: scale(0.85); filter: blur(8px); }
      100% { opacity: 1; filter: blur(0px); }
    }

    @keyframes loaderProgress {
      0% { width: 0%; }
      100% { width: 100%; }
    }

    header {
      background-color: #10141d;
      border-bottom: 1px solid var(--card-border);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .brand-title { font-size: 1.5rem; font-weight: 900; letter-spacing: 1px; }
    .brand-title span { color: var(--accent); }

    .nav-tabs { display: flex; align-items: center; gap: 10px; overflow-x: auto; padding: 12px 24px; background: #131722; border-bottom: 1px solid var(--card-border); }
    .nav-btn {
      background: transparent;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      padding: 8px 18px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .nav-btn.active, .nav-btn:hover { background: var(--accent); color: #000; border-color: var(--accent); }

    .nav-btn.btn-supercup {
      font-size: 0.95rem;
      font-weight: 900;
      letter-spacing: 1px;
      color: #fff;
      border-color: #2a3344;
      background: #181d28;
    }
    .nav-btn.btn-supercup span { color: var(--accent); transition: color 0.2s ease; }
    .nav-btn.btn-supercup.active, .nav-btn.btn-supercup:hover { background: var(--accent); color: #000; border-color: var(--accent); }
    .nav-btn.btn-supercup.active span, .nav-btn.btn-supercup:hover span { color: #000; }

    .container { max-width: 1400px; margin: 20px auto; padding: 0 16px; }

    .bracket-selector {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 12px;
      margin-bottom: 20px;
    }
    .bracket-tab {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      padding: 7px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 700;
      font-size: 0.85rem;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .bracket-tab.active { background: var(--accent-blue); color: #000; border-color: var(--accent-blue); }

    .bracket-tab.bonus-tab {
      background: rgba(255, 179, 0, 0.12);
      border: 1.5px solid var(--accent-gold);
      color: var(--accent-gold);
      font-weight: 900;
      letter-spacing: 0.5px;
      box-shadow: 0 0 12px rgba(255, 179, 0, 0.25);
    }
    .bracket-tab.bonus-tab.active, .bracket-tab.bonus-tab:hover {
      background: var(--accent-gold);
      color: #000;
      border-color: var(--accent-gold);
      box-shadow: 0 0 18px rgba(255, 179, 0, 0.5);
    }

    .podium-box {
      background: linear-gradient(135deg, #181d29, #10131a);
      border: 1px solid #283042;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-around;
      align-items: center;
    }
    .podium-place { text-align: center; }
    .podium-place .rank { font-size: 0.75rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; }
    .podium-place .club { font-size: 1.15rem; font-weight: 900; margin-top: 4px; }
    .gold { color: var(--accent-gold); }
    .silver { color: #cbd5e1; }
    .bronze { color: #f97316; }

    .bracket-wrapper {
      overflow-x: auto;
      padding: 20px 10px 40px 10px;
      background: #0f121a;
      border: 1px solid var(--card-border);
      border-radius: 14px;
    }
    .bracket-tree {
      display: flex;
      align-items: stretch;
      min-width: max-content;
    }
    .bracket-round {
      display: flex;
      flex-direction: column;
      width: 230px;
    }
    .round-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent-blue);
      font-weight: 800;
      text-align: center;
      margin-bottom: 20px;
    }
    .round-matches {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      flex-grow: 1;
    }

    .match-node {
      display: flex;
      align-items: center;
      margin: 10px 0;
      position: relative;
    }
    .match-card {
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      z-index: 2;
    }
    .team-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 12px;
      font-size: 0.85rem;
      border-bottom: 1px solid #1c2230;
    }
    .team-row:last-child { border-bottom: none; }
    .team-row.winner {
      font-weight: 800;
      color: #fff;
      background: rgba(0, 230, 118, 0.08);
      border-left: 3px solid var(--accent);
    }
    .team-row.winner .score { color: var(--accent); font-weight: 900; }
    .score { font-family: monospace; font-size: 0.95rem; color: var(--text-muted); }

    .connector-col {
      display: flex;
      flex-direction: column;
      width: 40px;
    }
    .connector-space { height: 40px; }
    .connector-group {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      flex-grow: 1;
    }
    .connector-pair {
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex-grow: 1;
      position: relative;
    }
    .line-top, .line-bottom {
      width: 20px;
      border-right: 2px solid var(--line-color);
      position: absolute;
      right: 0;
    }
    .line-top { top: 25%; height: 25%; border-top: 2px solid var(--line-color); }
    .line-bottom { top: 50%; height: 25%; border-bottom: 2px solid var(--line-color); }
    .line-out {
      position: absolute;
      right: -20px;
      top: 50%;
      width: 20px;
      border-top: 2px solid var(--line-color);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--card-bg);
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--card-border);
    }
    th, td { padding: 12px 16px; text-align: left; }
    th { background: #121620; font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); }
    tr:not(:last-child) { border-bottom: 1px solid var(--card-border); }
    .rank-col { width: 55px; text-align: center; }

    .rank-badge-gold {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 24px;
      background: rgba(255, 179, 0, 0.15);
      border: 1px solid var(--accent-gold);
      color: var(--accent-gold);
      border-radius: 6px;
      font-weight: 800;
      font-size: 0.85rem;
    }
    .rank-badge-normal {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 24px;
      color: var(--text-muted);
      font-weight: 700;
      font-size: 0.85rem;
    }
    .star-badge {
      color: var(--accent-gold);
      margin-left: 6px;
      font-size: 0.8rem;
    }
    .divider-row td {
      background: #10141d;
      padding: 6px 16px;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #64748b;
      font-weight: 800;
      border-top: 1px solid #1e2433;
      border-bottom: 1px solid #1e2433;
    }

    .transfer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }
    .transfer-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 14px;
      transition: border-color 0.2s;
    }
    .transfer-card:hover {
      border-color: #3b4253;
    }
    .player-name { font-weight: 800; font-size: 1rem; margin-bottom: 6px; }
    .transfer-route { display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); }
    .transfer-route .to { color: var(--accent); font-weight: 700; }

    .clasico-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 24px;
    }
    .clasico-match-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 14px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: border-color 0.2s;
    }
    .clasico-match-card:hover {
      border-color: #3b4253;
    }
    .clasico-meta {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .clasico-tour { font-weight: 800; font-size: 0.95rem; color: var(--accent-gold); }
    .clasico-stage { font-size: 0.8rem; color: var(--text-muted); }
    .clasico-duel {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 1rem;
    }
    .clasico-team { font-weight: 700; width: 140px; }
    .clasico-team.team-koln { text-align: right; }
    .clasico-team.team-barca { text-align: left; }
    .clasico-team.winner-team { color: var(--accent); font-weight: 900; }
    .clasico-score {
      font-family: monospace;
      font-size: 1.1rem;
      font-weight: 900;
      background: #0f121a;
      padding: 4px 14px;
      border-radius: 6px;
      border: 1px solid var(--card-border);
      color: #fff;
    }

    /* ZPRÁVY / ČLÁNKY */
    .news-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
      max-width: 950px;
      margin: 0 auto;
    }
    .news-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      transition: border-color 0.2s;
    }
    .news-card:hover {
      border-color: #3b4253;
    }
    .news-image-wrapper {
      width: 100%;
      height: 320px;
      background: #080a0f;
      overflow: hidden;
      position: relative;
    }
    .news-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .news-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(11, 14, 20, 0.85);
      border: 1px solid var(--accent-gold);
      color: var(--accent-gold);
      padding: 4px 12px;
      border-radius: 6px;
      font-weight: 900;
      font-size: 0.8rem;
      letter-spacing: 0.5px;
      backdrop-filter: blur(4px);
    }
    .news-body {
      padding: 22px 24px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .news-title {
      font-size: 1.35rem;
      font-weight: 900;
      color: #fff;
      line-height: 1.3;
    }
    .news-text {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .news-highlight {
      background: #0f121a;
      border-left: 3px solid var(--accent);
      padding: 10px 14px;
      border-radius: 0 6px 6px 0;
      font-size: 0.88rem;
      color: #e2e8f0;
      margin-top: 4px;
    }

    .lineups-container {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .lineups-container {
        grid-template-columns: 1fr;
      }
      .news-image-wrapper {
        height: 220px;
      }
    }

    .lineup-sidebar {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .team-tab-btn {
      background: #0f121a;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      padding: 14px 18px;
      border-radius: 10px;
      text-align: left;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.2s ease;
    }
    .team-tab-btn:hover {
      border-color: #3b4253;
      color: #fff;
    }
    .team-tab-btn.active {
      background: #19202f;
      border-color: var(--accent);
      color: #fff;
    }
    .team-tab-btn.active::after {
      content: "●";
      color: var(--accent);
      font-size: 0.85rem;
    }

    .lineup-content-panel {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      overflow: hidden;
    }

    .lineup-team-banner {
      padding: 24px 30px;
      border-bottom: 1px solid var(--card-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .lineup-team-banner h2 {
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: 0.5px;
    }
    .lineup-formation-tag {
      background: rgba(0, 230, 118, 0.12);
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 6px 16px;
      border-radius: 20px;
      font-weight: 900;
      font-size: 0.85rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .pitch-stage-wrapper {
      perspective: 1100px;
      padding: 30px 20px 30px 20px;
      display: flex;
      justify-content: center;
      background: #090c12;
      overflow: hidden;
    }

    .pitch-tactical-board {
      position: relative;
      width: 100%;
      max-width: 720px;
      height: 640px;
      background: linear-gradient(180deg, #121620 0%, #171d29 100%);
      transform: rotateX(12deg);
      border: 2.5px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 25px 50px rgba(0,0,0,0.85), inset 0 0 80px rgba(0,0,0,0.5);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 20px 10px 20px 10px;
    }

    .pitch-half-line-top {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      border-top: 2px solid rgba(255, 255, 255, 0.15);
      pointer-events: none;
    }
    .pitch-center-arc-top {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 150px;
      height: 150px;
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 50%;
      pointer-events: none;
    }
    .pitch-box-penalty-bottom {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 340px;
      height: 110px;
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-bottom: none;
      pointer-events: none;
    }
    .pitch-penalty-arc-bottom {
      position: absolute;
      bottom: 110px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 45px;
      border-top: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 50px 50px 0 0;
      pointer-events: none;
    }

    .pitch-formation-row {
      display: flex;
      justify-content: space-around;
      align-items: center;
      width: 100%;
      z-index: 2;
    }

    .tactical-player {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 95px;
      position: relative;
    }

    .player-visual-cluster {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      position: relative;
    }

    .tactical-jersey {
      position: relative;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 6px 8px rgba(0,0,0,0.7));
    }
    .tactical-jersey svg {
      width: 100%;
      height: 100%;
    }

    .ea-rating-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: #0d1118;
      border: 1px solid #2a3449;
      border-radius: 4px;
      padding: 1px 4px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.8);
    }
    .ea-ovr-val {
      font-size: 0.85rem;
      font-weight: 900;
      color: #ffffff;
      line-height: 1.1;
      font-family: monospace;
    }
    .ea-form-bar {
      width: 100%;
      height: 2.5px;
      background: #00e676;
      border-radius: 2px;
      margin-top: 2px;
      box-shadow: 0 0 6px #00e676;
    }

    .tactical-label {
      margin-top: 5px;
      background: rgba(10, 13, 19, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 4px;
      padding: 2px 7px;
      display: flex;
      align-items: center;
      gap: 4px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.8);
    }
    .tactical-label .c-tag {
      background: #f1f5f9;
      color: #0b0e14;
      font-weight: 900;
      font-size: 0.62rem;
      padding: 0 3px;
      border-radius: 2px;
      line-height: 1.2;
    }
    .tactical-label .player-name-text {
      color: #ffffff;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.3px;
      white-space: nowrap;
      text-transform: uppercase;
    }

    .tactical-player::after {
      content: '';
      position: absolute;
      bottom: -6px;
      width: 48px;
      height: 6px;
      background: rgba(0,0,0,0.6);
      border-radius: 50%;
      filter: blur(3px);
    }

    .hidden { display: none !important; }
  </style>
</head>
<body>

  <div id="splash-screen" onclick="this.style.display='none'">
    <div class="splash-logo">SUPER<span>LIVE</span></div>
    <div class="splash-loader">
      <div class="splash-loader-bar"></div>
    </div>
  </div>

  <header>
    <div class="brand">
      <div class="brand-title">SUPER<span>LIVE</span></div>
    </div>
  </header>

  <div class="nav-tabs">
    <button class="nav-btn btn-supercup active" onclick="switchSection('tournaments', this)">SUPER<span>CUP</span></button>
    <button class="nav-btn" onclick="switchSection('news', this)">Zprávy</button>
    <button class="nav-btn" onclick="switchSection('table', this)">Historická tabulka</button>
    <button class="nav-btn" onclick="switchSection('clasico', this)">El Clásico</button>
    <button class="nav-btn" onclick="switchSection('transfers', this)">Přestupový trh</button>
    <button class="nav-btn" onclick="switchSection('lineups', this)">Sestavy</button>
  </div>

  <div class="container">
    <section id="sec-tournaments">
      <div class="bracket-selector" id="bracket-tabs"></div>
      <div id="podium-area"></div>
      <div class="bracket-wrapper">
        <div class="bracket-tree" id="bracket-tree-display"></div>
      </div>
    </section>

    <!-- SEKCE ZPRÁVY -->
    <section id="sec-news" class="hidden">
      <div class="news-grid" id="news-container"></div>
    </section>

    <section id="sec-table" class="hidden">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 0 4px;">
        <span style="font-size: 0.85rem; color: var(--accent-gold); font-weight: 700;">
          ★ Týmy se zlatým číslem vyhrály aspoň 1 titul (kvalifikace pro BONUS)
        </span>
