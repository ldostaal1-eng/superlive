    function switchSection(secId, btn) {
      document.querySelectorAll('.nav-tabs .nav-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      document.getElementById('sec-tournaments').classList.add('hidden');
      document.getElementById('sec-news').classList.add('hidden');
      document.getElementById('sec-table').classList.add('hidden');
      document.getElementById('sec-clasico').classList.add('hidden');
      document.getElementById('sec-transfers').classList.add('hidden');
      document.getElementById('sec-lineups').classList.add('hidden');
      document.getElementById('sec-' + secId).classList.remove('hidden');
    }

    function renderTournaments() {
      const tabsCont = document.getElementById('bracket-tabs');
      tabsCont.innerHTML = '';
      const keys = Object.keys(tournamentsData);
      keys.forEach((k, idx) => {
        const btn = document.createElement('button');
        const isBonus = tournamentsData[k].isBonus;
        btn.className = 'bracket-tab' + (isBonus ? ' bonus-tab' : '') + (idx === 0 ? ' active' : '');
        btn.innerText = tournamentsData[k].name;
        btn.onclick = () => selectTournament(k, btn);
        tabsCont.appendChild(btn);
      });
      loadTournamentData(keys[0]);
    }

    function selectTournament(key, btn) {
      document.querySelectorAll('.bracket-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      loadTournamentData(key);
    }

    function loadTournamentData(key) {
      const tour = tournamentsData[key];
      const podium = document.getElementById('podium-area');
      podium.innerHTML = `
        <div class="podium-box">
          <div class="podium-place gold"><div class="rank">1. Místo</div><div class="club">${tour.podium.gold}</div></div>
          <div class="podium-place silver"><div class="rank">2. Místo</div><div class="club">${tour.podium.silver}</div></div>
          <div class="podium-place bronze"><div class="rank">3. Místo</div><div class="club">${tour.podium.bronze}</div></div>
        </div>
      `;

      const tree = document.getElementById('bracket-tree-display');
      tree.innerHTML = '';

      tour.rounds.forEach((round, rIndex) => {
        const roundCol = document.createElement('div');
        roundCol.className = 'bracket-round';
        roundCol.innerHTML = `<div class="round-title">${round.title}</div>`;

        const matchesContainer = document.createElement('div');
        matchesContainer.className = 'round-matches';

        round.matches.forEach(m => {
          const node = document.createElement('div');
          node.className = 'match-node';
          node.innerHTML = `
            <div class="match-card">
              <div class="team-row ${m.win === 1 ? 'winner' : ''}">
                <span>${m.t1}</span>
                <span class="score">${m.s1}</span>
              </div>
              <div class="team-row ${m.win === 2 ? 'winner' : ''}">
                <span>${m.t2}</span>
                <span class="score">${m.s2}</span>
              </div>
            </div>
          `;
          matchesContainer.appendChild(node);
        });

        roundCol.appendChild(matchesContainer);
        tree.appendChild(roundCol);

        if (rIndex < tour.rounds.length - 1) {
          const connCol = document.createElement('div');
          connCol.className = 'connector-col';
          connCol.innerHTML = `<div class="connector-space"></div>`;

          const connGroup = document.createElement('div');
          connGroup.className = 'connector-group';

          const pairsCount = Math.floor(round.matches.length / 2);
          for (let p = 0; p < pairsCount; p++) {
            const pair = document.createElement('div');
            pair.className = 'connector-pair';
            pair.innerHTML = `
              <div class="line-top"></div>
              <div class="line-bottom"></div>
              <div class="line-out"></div>
            `;
            connGroup.appendChild(pair);
          }

          connCol.appendChild(connGroup);
          tree.appendChild(connCol);
        }
      });
    }

    function renderNews() {
      const container = document.getElementById('news-container');
      container.innerHTML = '';
      newsArticles.forEach(item => {
        const card = document.createElement('div');
        card.className = 'news-card';
        card.innerHTML = `
          <div class="news-image-wrapper">
            <span class="news-badge">${item.tour}</span>
            <img src="${item.image}" alt="${item.title}" onerror="this.style.display='none'" />
          </div>
          <div class="news-body">
            <h3 class="news-title">${item.title}</h3>
            <p class="news-text">${item.text}</p>
            <div class="news-highlight">💡 ${item.highlight}</div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function renderClasico() {
      const cont = document.getElementById('clasico-matches-container');
      cont.innerHTML = '';
      clasicoMatches.forEach(m => {
        const card = document.createElement('div');
        card.className = 'clasico-match-card';
        card.innerHTML = `
          <div class="clasico-meta">
            <span class="clasico-tour">${m.tour}</span>
            <span class="clasico-stage">${m.stage}</span>
          </div>
          <div class="clasico-duel">
            <span class="clasico-team team-koln ${m.winner === 'Köln' ? 'winner-team' : ''}">1. FC Köln</span>
            <span class="clasico-score">${m.sKöln} : ${m.sBarca}</span>
            <span class="clasico-team team-barca ${m.winner === 'Barca' ? 'winner-team' : ''}">FC Barcelona</span>
          </div>
        `;
        cont.appendChild(card);
      });
    }

    function renderTable() {
      const tbody = document.getElementById('table-body');
      tbody.innerHTML = '';
      allTimeTable.forEach((item, idx) => {
        const hasTitle = item.g > 0;

        if (idx === 15) {
          const divTr = document.createElement('tr');
          divTr.className = 'divider-row';
          divTr.innerHTML = `<td colspan="5">Týmy bez titulu</td>`;
          tbody.appendChild(divTr);
        }

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="rank-col">
            <span class="${hasTitle ? 'rank-badge-gold' : 'rank-badge-normal'}">${idx + 1}</span>
          </td>
          <td style="font-weight: 700; color: ${hasTitle ? '#fff' : 'var(--text-muted)'};">
            ${item.club} ${hasTitle ? '<span class="star-badge">★</span>' : ''}
          </td>
          <td style="color: var(--accent-gold); font-weight: 800;">${item.g}</td>
          <td style="color: #cbd5e1; font-weight: 700;">${item.s}</td>
          <td style="color: #f97316; font-weight: 700;">${item.b}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderTransfers() {
      const container = document.getElementById('transfers-container');
      container.innerHTML = '';
      transfers.forEach(t => {
        const card = document.createElement('div');
        card.className = 'transfer-card';
        card.innerHTML = `
          <div class="player-name">${t.name}</div>
          <div class="transfer-route">
            <span>${t.from}</span>
            <span>➔</span>
            <span class="to">${t.to}</span>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function getKitSvg(type) {
      if (type === 'gk') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#eab308" />
            <path d="M7 15L12 25L14.5 23.5L9.5 13.5L7 15Z" fill="#111827" />
            <path d="M53 15L48 25L45.5 23.5L50.5 13.5L53 15Z" fill="#111827" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#111827" />
            <path d="M18 45H42V48H18V45Z" fill="#111827" />
          </svg>
        `;
      }
      if (type === 'koln') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#f8fafc" />
            <path d="M26 14H34V48H26V14Z" fill="#dc2626" />
            <path d="M7 15L12 25L14.5 23.5L9.5 13.5L7 15Z" fill="#dc2626" />
            <path d="M53 15L48 25L45.5 23.5L50.5 13.5L53 15Z" fill="#dc2626" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#dc2626" />
          </svg>
        `;
      }
      if (type === 'chelsea') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#1d4ed8" />
            <path d="M7 15L12 25L14.5 23.5L9.5 13.5L7 15Z" fill="#f8fafc" />
            <path d="M53 15L48 25L45.5 23.5L50.5 13.5L53 15Z" fill="#f8fafc" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#f8fafc" />
            <path d="M18 45H42V48H18V45Z" fill="#f59e0b" />
          </svg>
        `;
      }
      if (type === 'real') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#ffffff" />
            <path d="M16 8L7 15" stroke="#0f172a" stroke-width="2" />
            <path d="M44 8L53 15" stroke="#0f172a" stroke-width="2" />
            <path d="M7 15L12 25L14.5 23.5L9.5 13.5L7 15Z" fill="#0f172a" />
            <path d="M53 15L48 25L45.5 23.5L50.5 13.5L53 15Z" fill="#0f172a" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#0f172a" />
            <path d="M18 45H42V48H18V45Z" fill="#eab308" />
          </svg>
        `;
      }
      if (type === 'bayern') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#dc2626" />
            <path d="M7 15L12 25L14.5 23.5L9.5 13.5L7 15Z" fill="#ffffff" />
            <path d="M53 15L48 25L45.5 23.5L50.5 13.5L53 15Z" fill="#ffffff" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#ffffff" />
            <path d="M18 45H42V48H18V45Z" fill="#991b1b" />
          </svg>
        `;
      }
      if (type === 'barcelona') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#1e3a8a" />
            <path d="M23 13H28V48H23V13Z" fill="#991b1b" />
            <path d="M32 13H37V48H32V13Z" fill="#991b1b" />
            <path d="M7 15L12 25L14.5 23.5L9.5 13.5L7 15Z" fill="#991b1b" />
            <path d="M53 15L48 25L45.5 23.5L50.5 13.5L53 15Z" fill="#991b1b" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#eab308" />
          </svg>
        `;
      }
      if (type === 'mainz') {
        return `
          <svg viewBox="0 0 60 52" fill="none">
            <path d="M16 8L7 15L12 25L18 22V48H42V22L48 25L53 15L44 8C41 12 37 14 30 14C23 14 19 12 16 8Z" fill="#ef4444" />
            <path d="M7 15L16 8L18 22L12 25L7 15Z" fill="#ffffff" />
            <path d="M53 15L44 8L42 22L48 25L53 15Z" fill="#ffffff" />
            <path d="M22 8C24 12 27 13 30 13C33 13 36 12 38 8C35 9.5 32 10 30 10C28 10 25 9.5 22 8Z" fill="#ffffff" />
          </svg>
        `;
      }
      return '';
    }

    function renderLineups() {
      const menu = document.getElementById('lineup-team-menu');
      menu.innerHTML = '';
      const keys = Object.keys(lineupsDatabase);

      keys.forEach((k, idx) => {
        const team = lineupsDatabase[k];
        const btn = document.createElement('button');
        btn.className = 'team-tab-btn' + (idx === 0 ? ' active' : '');
        btn.innerHTML = `<span>${team.name}</span>`;
        btn.onclick = () => {
          document.querySelectorAll('.team-tab-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          displayLineup(k);
        };
        menu.appendChild(btn);
      });

      displayLineup(keys[0]);
    }

    function displayLineup(key) {
      const team = lineupsDatabase[key];
      const view = document.getElementById('lineup-view');

      const gkSvg = getKitSvg('gk');
      const outSvg = getKitSvg(team.kitType);

      const renderPlayer = (p, svgContent) => `
        <div class="tactical-player">
          <div class="player-visual-cluster">
            <div class="tactical-jersey">
              ${svgContent}
            </div>
            <div class="ea-rating-badge">
              <span class="ea-ovr-val">${p.ovr}</span>
              <div class="ea-form-bar"></div>
            </div>
          </div>
          <div class="tactical-label">
            ${p.captain ? '<span class="c-tag">C</span>' : ''}
            <span class="player-name-text">${p.name}</span>
          </div>
        </div>
      `;

      let rowsHtml = '';

      for (let i = team.lines.length - 1; i >= 0; i--) {
        const line = team.lines[i];
        let lineHtml = '';
        line.forEach(p => {
          lineHtml += renderPlayer(p, outSvg);
        });
        rowsHtml += `<div class="pitch-formation-row">${lineHtml}</div>`;
      }

      rowsHtml += `
        <div class="pitch-formation-row" style="margin-bottom: 6px;">
          ${renderPlayer(team.gk, gkSvg)}
        </div>
      `;

      view.innerHTML = `
        <div class="lineup-team-banner" style="background: ${team.bannerBg};">
          <div>
            <h2>${team.name}</h2>
            <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 700;">STARTING XI</span>
          </div>
          <div class="lineup-formation-tag">${team.formation}</div>
        </div>

        <div class="pitch-stage-wrapper">
          <div class="pitch-tactical-board">
            <div class="pitch-half-line-top"></div>
            <div class="pitch-center-arc-top"></div>
            <div class="pitch-box-penalty-bottom"></div>
            <div class="pitch-penalty-arc-bottom"></div>
            ${rowsHtml}
          </div>
        </div>
      `;
    }

    try {
      renderTournaments();
      renderNews();
      renderClasico();
      renderTable();
      renderTransfers();
      renderLineups();
    } catch(err) {
      console.error(err);
    }
  </script>
</body>
</html>